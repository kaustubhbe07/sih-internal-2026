# TrueMark Backend Environment Variables

# ==========================================
# Database Configuration
# ==========================================
# Connection string for Supabase PostgreSQL database
# Make sure to use the connection pooling URL (usually port 6543 for Supabase pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ==========================================
# Security & Authentication
# ==========================================
# Secret key used for cryptographic operations in the auth service
SECRET_KEY="sih2026-super-secret-key"

# Secret key used for signing JWT tokens (Change this in production)
JWT_SECRET="change-me-in-production-for-jwt"

# Algorithm used for JWT encoding (default: HS256)
JWT_ALGORITHM="HS256"

# Expiry time for JWT tokens in minutes
JWT_EXPIRY_MINUTES="60"

# ==========================================
# Application Settings
# ==========================================
# Base URL for the backend API
BASE_URL="http://localhost:8000"

# Allowed origin for CORS (Cross-Origin Resource Sharing)
# In production, set this to the actual domain where the frontend is hosted
# In development, you can use "*" or the local URL
FRONTEND_URL="*"
